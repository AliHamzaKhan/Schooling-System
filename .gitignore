# ── Python (backend) ─────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
# Scope the Python venv "env" ignore to the backend so it doesn't swallow
# unrelated Dart source dirs (e.g. frontend/shared/lib/src/env/).
backend/env/
*.log

# Local file-storage bucket (STORAGE_BACKEND=local) — dev uploads, never commit.
backend/uploads/

# ── Environment / secrets ────────────────────────
.env
.env.*
!.env.example

# ── Flutter / Dart (frontend) ────────────────────
# (each app also has its own .gitignore; these are belt-and-suspenders)
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
.packages
**/*.iml

# ── IDE / OS ─────────────────────────────────────
.idea/
.vscode/
.DS_Store

# Firebase service-account keys — live credentials, never commit.
# Match anywhere in the name — Firebase names keys like
# "<project>-firebase-adminsdk-<hash>.json", so a leading anchor misses them.
*serviceAccount*.json
*firebase-adminsdk*.json
*firebase-service-account*.json
