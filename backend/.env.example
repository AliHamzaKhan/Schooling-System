# Application
PROJECT_NAME="Schooling System API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/schooling

# Worker visibility: mark the notification-outbox worker stale after this many
# seconds without a database heartbeat. Keep this above its 10-second poll.
OUTBOX_WORKER_STALE_AFTER_SECONDS=60

# Use json in staging/production so logs are machine-readable and safely indexed.
LOG_FORMAT=text

# JWT
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300
REFRESH_TOKEN_EXPIRE_DAYS=30

# First Super Admin (created by seed)
FIRST_SUPERADMIN_EMAIL=admin@platform.com
FIRST_SUPERADMIN_PASSWORD=ChangeMe123!

# CORS (comma-separated)
BACKEND_CORS_ORIGINS=*

# --- Upload scanner --- #
# Development/test only. Production must use ClamAV with a private-network host.
UPLOAD_SCANNER_BACKEND=disabled
UPLOAD_SCANNER_HOST=
UPLOAD_SCANNER_PORT=3310
UPLOAD_SCANNER_TIMEOUT_SECONDS=15

# --- Communication providers (leave blank to run in stub/log mode) ---
# Twilio (WhatsApp + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886
# Firebase Cloud Messaging (push) — legacy server key
# Legacy FCM key — Google shut this endpoint down in July 2024. Unused.
FCM_SERVER_KEY=
# Firebase Cloud Messaging HTTP v1. Set ONE of these:
#   path to the service-account JSON (recommended for local dev)
FIREBASE_CREDENTIALS_FILE=
#   or the file's raw contents, for container / secret-manager deploys
FIREBASE_CREDENTIALS_JSON=
#   or base64-encoded JSON for line-safe CI/CD environment generation
FIREBASE_CREDENTIALS_JSON_B64=
# Email over SMTP (blank SMTP_HOST = simulated, nothing sent). See docs/DELIVERY_SETUP.md
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587) | ssl (465) | none (local relay only)
SMTP_SECURITY=starttls
